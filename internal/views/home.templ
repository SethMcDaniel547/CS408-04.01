package views

import (
	"fmt"
	"HelloWorld/internal/models"
)

// Update Home to accept the courses slice
templ Home(courses []models.Course) {
    @Layout("Canvas Dashboard") {
        <div class="max-w-4xl mx-auto px-4 py-12">
            <div class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">
                    Your Canvas Courses
                </h1>
                <p class="text-lg text-gray-300 max-w-2xl mx-auto">
                    Loaded automatically from your environment configuration.
                </p>
            </div>

            <!-- Courses Container -->
            <div class="space-y-6">
                if len(courses) == 0 {
                    <div class="bg-gray-800/50 backdrop-blur-sm rounded-xl p-8 border border-gray-700 text-center text-gray-400 shadow-xl">
                        <p class="text-lg">No courses found or failed to connect to Canvas.</p>
                        <p class="text-sm text-gray-500 mt-2">Check your .env file to ensure your API token and base URL are correct.</p>
                    </div>
                } else {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        for _, course := range courses {
                            <div class="bg-gray-800/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700 hover:border-emerald-500/50 transition-all duration-300 flex flex-col justify-between shadow-lg">
                                <div>
                                    <h3 class="text-xl font-semibold text-white mb-2">{ course.Name }</h3>
                                    <p class="text-gray-400 text-sm">{ course.Code }</p>
                                </div>
                                <div class="mt-6">
                                    <button hx-get={ fmt.Sprintf("/courses/%d/assignments", course.ID) }
                                            hx-target="#main-content-area"
                                            hx-swap="innerHTML"
                                            class="w-full text-center bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 px-4 py-2.5 rounded-lg font-medium transition-colors">
                                        View Assignments &rarr;
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div id="main-content-area"></div>
        </div>
    }
}
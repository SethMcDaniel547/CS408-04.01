package views

import (
	"fmt"
	"HelloWorld/internal/models"
)

templ AssignmentView(courseID string, assignments []models.Assignment) {
    <div class="bg-gray-800/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700 shadow-lg mt-6">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-semibold text-emerald-400">Assignments for Course</h2>
            <button hx-get="/" hx-target="#main-content-area" hx-swap="innerHTML" class="text-sm text-gray-400 hover:text-white underline">
                &larr; Back to Courses
            </button>
        </div>
        
        if len(assignments) == 0 {
            <div class="text-center py-8 text-gray-400">
                <p>No assignments found for this course.</p>
            </div>
        } else {
            <div class="space-y-6">
                for _, assignment := range assignments {
                    <div class="bg-gray-700/50 rounded-lg p-6 border border-gray-600 hover:border-emerald-500/50 transition-all duration-300">
                        <h3 class="text-xl font-semibold text-white">{ assignment.Name }</h3>
                        
                        if assignment.DueAt != "" {
                            <p class="text-gray-400 text-sm mt-1">Due: { assignment.DueAt }</p>
                        }
                        
                        if assignment.PointsPossible > 0 {
                            <p class="text-gray-400 text-sm mt-1">Points: { fmt.Sprintf("%g", assignment.PointsPossible) }</p>
                        }
                        
                        <!-- Submission Form -->
                        <div class="mt-4 pt-4 border-t border-gray-600/50">
                            <form hx-post="/submit-assignment" 
                                  hx-target={ fmt.Sprintf("#result-%d", assignment.ID) }
                                  hx-swap="innerHTML"
                                  class="space-y-3">
                                <input type="hidden" name="course_id" value={ courseID }/>
                                <input type="hidden" name="assignment_id" value={ fmt.Sprintf("%d", assignment.ID) }/>
                                
                                <div>
                                    <label class="block text-xs font-medium text-gray-300 mb-1">Submission URL (GitHub, Google Doc, etc.)</label>
                                    <input type="url" 
                                           name="submission_url" 
                                           required 
                                           placeholder="https://github.com/your-repo/project"
                                           class="w-full px-3 py-2 bg-gray-900/80 border border-gray-600 rounded-lg text-sm text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500"/>
                                </div>
                                
                                <button type="submit" 
                                        class="bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-600 hover:to-cyan-600 px-4 py-2 rounded-lg text-sm font-semibold transition-all shadow">
                                    Submit to Canvas
                                </button>
                            </form>
                            
                            <!-- Unique result container for this specific assignment -->
                            <div id={ fmt.Sprintf("result-%d", assignment.ID) } class="mt-3"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}